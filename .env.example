# 复制此文件为 .env 并修改配置
APP_NAME=库房管理系统
APP_VERSION=1.0.0

# 数据库：默认 SQLite（本地文件），可改为 MySQL/PostgreSQL
# SQLite:
DATABASE_URL=sqlite:///./data/wms.db
# MySQL 示例（需安装 pip install pymysql）:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/wms
# PostgreSQL 示例（需安装 pip install psycopg2-binary）:
# DATABASE_URL=postgresql://user:password@localhost:5432/wms

# JWT 密钥（生产环境请改成随机长字符串）
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
# Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 跨域允许的前端地址（多个用逗号分隔）
CORS_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:8080

# 默认管理员账号（首次启动自动创建）
DEFAULT_ADMIN_ID=admin
DEFAULT_ADMIN_NAME=管理员
DEFAULT_ADMIN_PASSWORD=123456

# 库存预警默认阈值
DEFAULT_WARN_THRESHOLD=10
